    "jose": "^6.2.9",
    "mongodb": "^6.12.0",
    "undici": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}