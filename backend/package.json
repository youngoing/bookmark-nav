{
  "name": "@loomark/backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
