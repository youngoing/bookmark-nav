{
  "name": "bookmark-nav",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "pnpm --filter @loomark/frontend dev",
    "build": "pnpm --filter @loomark/frontend build",
    "start": "pnpm --filter @loomark/frontend start",
    "lint": "pnpm --filter @loomark/frontend lint",
    "dev:frontend": "pnpm --filter @loomark/frontend dev",
    "dev:backend": "pnpm --filter @loomark/backend dev",
    "build:frontend": "pnpm --filter @loomark/frontend build",
    "build:backend": "pnpm --filter @loomark/backend build",
    "deploy:backend": "bash scripts/deploy-backend.sh",
    "deploy:frontend": "bash scripts/deploy-frontend.sh",
    "typecheck:backend": "pnpm --filter @loomark/backend typecheck",
    "test": "pnpm --filter @loomark/frontend test",
    "test:watch": "pnpm --filter @loomark/frontend test:watch"
  },
  "dependencies": {
    "@trpc/client": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "jose": "^6.0.10",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.12.0",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "pm2": "^7.0.3",
    "typescript": "^5.7.2"
  }
}
