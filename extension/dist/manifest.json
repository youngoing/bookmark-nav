{
  "manifest_version": 3,
  "name": "bookmark-nav",
  "version": "1.0.0",
  "description": "一键保存当前页面到 bookmark-nav",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 bookmark-nav"
  }
}
