{
  "manifest_version": 3,
  "name": "bookmark-nav",
  "version": "1.1.0",
  "description": "一键保存当前页面到 bookmark-nav",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存到 bookmark-nav",
    "default_icon": {
      "16": "icon.svg",
      "32": "icon.svg"
    }
  }
}
